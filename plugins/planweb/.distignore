# Files excluded from the distributed plugin zip (wp dist-archive / build-zip).
# The WordPress.org directory wants the source (src/) shipped, so src/ is NOT excluded.
# Has no effect on the live symlinked deploy; only shapes a built zip.

/.distignore
/.editorconfig
/.gitattributes
/.gitignore
/.github
/tests
/src/.gitkeep
/node_modules
/package.json
/package-lock.json
/webpack.config.js
/phpcs.xml
/phpcs.xml.dist
/.phpcs.xml.dist
