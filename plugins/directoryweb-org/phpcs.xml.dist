<?xml version="1.0"?>
<ruleset name="DirectoryWeb">
	<description>Coding standards for the DirectoryWeb WordPress plugin (WordPress.org distribution).</description>

	<file>.</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>*/node_modules/</exclude-pattern>
	<exclude-pattern>/dist/</exclude-pattern>
	<exclude-pattern>*/build/</exclude-pattern>
	<exclude-pattern>*/packages/directoryweb-shell/src/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="directoryweb"/>
				<element value="DirectoryWeb"/>
				<element value="DIRECTORYWEB"/>
			</property>
		</properties>
		<!-- Test runners define ABSPATH to satisfy the direct-access guards of the files under test. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="directoryweb"/>
			</property>
		</properties>
	</rule>

	<!-- Test files are PHPUnit-style: snake_case cases, data-provider closures with intentionally unused
	     parameters, and helpers that need no full doc blocks. These sniffs are not meaningful there. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
