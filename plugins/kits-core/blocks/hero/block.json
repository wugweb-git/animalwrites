{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kits/hero",
	"title": "Hero",
	"category": "design",
	"description": "The page hero: a full-width band that holds the page's H1, one line and its actions. Its height, colours, padding, border and shadow are block supports, so they are set in Styles (Blocks > Hero) for every hero, or on one hero in the editor.",
	"keywords": [ "hero", "banner", "page head", "kits" ],
	"textdomain": "kits-core",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"spacing": {
			"padding": true,
			"margin": [ "top", "bottom" ],
			"blockGap": true
		},
		"dimensions": {
			"minHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"layout": {
			"allowSizingOnChildren": true,
			"default": {
				"type": "constrained"
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
}
