{
  "name": "kits-core-admin",
  "private": true,
  "description": "Kits Core admin screens (built with @wordpress/scripts; build/ is committed because the deploy does not run npm).",
  "scripts": {
    "build": "npm run build:theme-options && npm run build:shell && npm run build:settings-next",
    "build:theme-options": "wp-scripts build src/theme-options/index.js --output-path=build/theme-options",
    "build:shell": "wp-scripts build src/shell/index.js --output-path=build/shell",
    "lint:js": "wp-scripts lint-js src",
    "build:settings-next": "wp-scripts build src/settings-next/index.js --output-path=build/settings-next"
  },
  "devDependencies": {
    "@wordpress/scripts": "32.6.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/media-utils": "^6.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
