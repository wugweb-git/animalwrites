{
  "$breakpoints": {
    "sm": 0,
    "md": 768,
    "lg": 1200
  },
  "$primitives": {
    "color": {
      "ink": "#141414",
      "ink-soft": "#1e1e1e",
      "paper": "#ffffff",
      "kraft": "#efe4cf",
      "kraft-soft": "#faf6ee",
      "muted": "#5f5f5f",
      "line": "#e4ddd0",
      "red": "#c8102e",
      "red-soft": "#fff2f4",
      "green": "#137a3b",
      "green-soft": "#eef8f1",
      "whatsapp": "#1f7a44",
      "canvas": "#f6f3ee",
      "wugweb-yellow": "#ffbe1a",
      "link-blue": "#0062b8"
    },
    "font": {
      "display": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "body": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    }
  },
  "tokens": {
    "color-bg": {
      "sm": "var(--neutral-1)"
    },
    "color-surface": {
      "sm": "{color.kraft}"
    },
    "color-surface-soft": {
      "sm": "var(--neutral-0)"
    },
    "color-ink": {
      "sm": "{color.ink}"
    },
    "color-text": {
      "sm": "{color.ink-soft}"
    },
    "color-muted": {
      "sm": "{color.muted}"
    },
    "color-line": {
      "sm": "{color.line}"
    },
    "color-accent-ink": {
      "sm": "{color.link-blue}"
    },
    "color-on-accent": {
      "sm": "{color.ink}"
    },
    "color-danger": {
      "sm": "{color.red}"
    },
    "color-danger-soft": {
      "sm": "{color.red-soft}"
    },
    "color-success": {
      "sm": "{color.green}"
    },
    "color-success-soft": {
      "sm": "{color.green-soft}"
    },
    "color-focus": {
      "sm": "{color.link-blue}"
    },
    "color-whatsapp": {
      "sm": "{color.whatsapp}"
    },
    "font-display": {
      "sm": "{font.display}"
    },
    "font-body": {
      "sm": "{font.body}"
    },
    "radius-control": {
      "sm": "8px"
    },
    "radius-card": {
      "sm": "12px"
    },
    "color-canvas": {
      "sm": "var(--neutral-1)"
    },
    "color-link": {
      "sm": "{color.link-blue}"
    },
    "surface-page": {
      "sm": "var(--kit-color-canvas)"
    },
    "field-text-size": {
      "sm": "1rem",
      "md": ".875rem",
      "$comment": "16px below 768 so iOS does not zoom into a field"
    },
    "type-sm": {
      "sm": "var(--fluid-body-sm)",
      "md": "clamp(.75rem, .7273rem + .0909vw, .8125rem)"
    },
    "type-xs": {
      "sm": "var(--fluid-label)",
      "md": "clamp(.6875rem, .6591rem + .1136vw, .75rem)"
    },
    "meta-size": {
      "sm": "12px",
      "md": ".8125rem",
      "lg": ".8125rem"
    },
    "btn-font-size": {
      "sm": ".875rem"
    },
    "section-desc-size": {
      "sm": ".875rem"
    },
    "card-min": {
      "sm": "18rem",
      "$comment": "docs/card-sizes.md"
    },
    "card-media-max": {
      "sm": "22.5rem"
    },
    "thumb-min": {
      "sm": "4.5rem"
    },
    "thumb-max": {
      "sm": "15rem"
    },
    "body-min": {
      "sm": "10rem"
    },
    "card-min-width": {
      "sm": "min(100%, var(--kit-card-min))"
    },
    "card-stacked-gap": {
      "sm": "clamp(var(--kit-space-3), 5vw, var(--kit-space-5))"
    },
    "card-stacked-media": {
      "sm": "clamp(var(--kit-thumb-min), 30%, var(--kit-thumb-max))",
      "$comment": "docs/card-sizes.md: picture 30%, 4.5 to 15rem"
    },
    "card-stacked-media-max": {
      "sm": "none"
    },
    "card-stacked-media-flex": {
      "sm": "0 1 auto"
    },
    "card-stacked-media-min": {
      "sm": "var(--kit-thumb-min)"
    },
    "card-stacked-body-flex": {
      "sm": "1 1 0"
    },
    "card-stacked-body-min": {
      "sm": "var(--kit-body-min)",
      "$comment": "docs/card-sizes.md: text column at least 10rem"
    },
    "card-block-media-max": {
      "sm": "var(--kit-card-media-max)"
    },
    "lead-title-leading": {
      "sm": "1.25",
      "md": "1.25",
      "lg": "1.25"
    }
  }
}
