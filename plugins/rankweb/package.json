{
  "name": "rankweb-admin",
  "private": true,
  "description": "RankWeb's admin screens on the Kits shell (built with @wordpress/scripts; build/ is committed because the deploy does not run npm).",
  "scripts": {
    "build": "wp-scripts build index=./src/index.js blocks/breadcrumbs=./src/blocks/breadcrumbs.js --output-path=build",
    "lint:js": "wp-scripts lint-js src"
  },
  "devDependencies": {
    "@wordpress/scripts": "32.6.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/block-editor": "^15.23.0",
    "@wordpress/blocks": "^15.27.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/server-side-render": "^6.33.0"
  },
  "engines": {
    "node": ">=20"
  }
}
