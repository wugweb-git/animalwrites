{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Marigold",
					"color": "#ffa500"
				},
				{
					"slug": "primary-dark",
					"name": "Accent dark (text)",
					"color": "#9a5b00"
				},
				{
					"slug": "secondary",
					"name": "Ink",
					"color": "#141414"
				},
				{
					"slug": "background",
					"name": "Paper",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Kraft",
					"color": "#efe4cf"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "#1e1e1e"
				},
				{
					"slug": "text-muted",
					"name": "Text muted",
					"color": "#6e6e6e"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#e6e6e6"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#16a249"
				},
				{
					"slug": "warning",
					"name": "Warning",
					"color": "#c88a04"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#dc2626"
				},
				{
					"slug": "marker-red",
					"name": "Marker red",
					"color": "#c8102e"
				}
			]
		},
		"custom": {
			"radius": {
				"control": "var(--aw-radius-control)",
				"card": "var(--aw-radius-card)",
				"media": "var(--aw-radius-media)",
				"hero": "var(--aw-radius-hero)",
				"pill": "var(--aw-radius-pill)"
			}
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "base",
					"name": "Inter Tight",
					"fontFamily": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter Tight",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-tight/inter-tight-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display",
					"name": "Tiro Devanagari Hindi",
					"fontFamily": "\"Tiro Devanagari Hindi\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Tiro Devanagari Hindi",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/tiro/tiro-devanagari-hindi-devanagari.woff2"
							],
							"unicodeRange": "U+0900-097F, U+1CD0-1CF9, U+200C-200D, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF, U+11B00-11B09"
						},
						{
							"fontFamily": "Tiro Devanagari Hindi",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/tiro/tiro-devanagari-hindi-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Tiro Devanagari Hindi",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/tiro/tiro-devanagari-hindi-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"border": {
					"radius": "var(--aw-radius-control)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontWeight": "600"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.08",
					"letterSpacing": "-0.01em"
				}
			}
		}
	}
}