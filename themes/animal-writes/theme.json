{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Marigold",
					"color": "#ffa500"
				},
				{
					"slug": "primary-dark",
					"name": "Accent dark (text)",
					"color": "#9a5b00"
				},
				{
					"slug": "secondary",
					"name": "Ink",
					"color": "#141414"
				},
				{
					"slug": "background",
					"name": "Paper",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Kraft",
					"color": "#efe4cf"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "#1e1e1e"
				},
				{
					"slug": "text-muted",
					"name": "Text muted",
					"color": "#6e6e6e"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#e6e6e6"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#16a249"
				},
				{
					"slug": "warning",
					"name": "Warning",
					"color": "#c88a04"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#dc2626"
				},
				{
					"slug": "marker-red",
					"name": "Marker red",
					"color": "#c8102e"
				}
			]
		},
		"custom": {
			"radius": {
				"control": "var(--aw-radius-control)",
				"card": "var(--aw-radius-card)",
				"media": "var(--aw-radius-media)",
				"hero": "var(--aw-radius-hero)",
				"pill": "var(--aw-radius-pill)"
			}
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "base",
					"name": "Inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "display",
					"name": "Inter (headings)",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-latin.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"border": {
					"radius": "var(--aw-radius-control)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontWeight": "600"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.08",
					"letterSpacing": "-0.01em"
				}
			}
		}
	}
}