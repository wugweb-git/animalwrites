{
  "$breakpoints": { "sm": 0, "md": 768, "lg": 1200 },
  "$primitives": {
    "color": {
      "marigold": "#ffa500", "marigold-ink": "#9a5b00", "ink": "#141414", "ink-soft": "#1e1e1e",
      "paper": "#ffffff", "kraft": "#efe4cf", "kraft-soft": "#faf6ee", "muted": "#5f5f5f",
      "line": "#e4ddd0", "red": "#c8102e", "red-soft": "#fff2f4", "green": "#137a3b", "green-soft": "#eef8f1", "whatsapp": "#1f7a44"
    },
    "font": {
      "display": "\"Tiro Devanagari Hindi\", Georgia, serif",
      "body": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    }
  },
  "tokens": {
    "color-bg":            { "sm": "{color.paper}" },
    "color-surface":       { "sm": "{color.kraft}" },
    "color-surface-soft":  { "sm": "{color.kraft-soft}" },
    "color-raised":        { "sm": "{color.paper}" },
    "color-ink":           { "sm": "{color.ink}" },
    "color-text":          { "sm": "{color.ink-soft}" },
    "color-muted":         { "sm": "{color.muted}" },
    "color-line":          { "sm": "{color.line}" },
    "color-accent":        { "sm": "{color.marigold}" },
    "color-accent-ink":    { "sm": "{color.marigold-ink}" },
    "color-on-accent":     { "sm": "{color.ink}" },
    "color-on-ink":        { "sm": "{color.paper}" },
    "color-danger":        { "sm": "{color.red}" },
    "color-danger-soft":   { "sm": "{color.red-soft}" },
    "color-success":       { "sm": "{color.green}" },
    "color-success-soft":  { "sm": "{color.green-soft}" },
    "color-focus":         { "sm": "{color.marigold}" },
    "color-whatsapp":      { "sm": "{color.whatsapp}" },

    "font-display":        { "sm": "{font.display}" },
    "font-body":           { "sm": "{font.body}" },

    "type-xs":      { "sm": "0.8125rem" },
    "type-sm":      { "sm": "0.875rem" },
    "type-base":    { "sm": "1rem", "lg": "1.0625rem" },
    "type-lead":    { "sm": "1.0625rem", "md": "1.125rem", "lg": "1.25rem" },
    "type-h4":      { "sm": "1.125rem", "md": "1.2rem" },
    "type-h3":      { "sm": "1.25rem", "md": "1.4rem", "lg": "1.5rem" },
    "type-h2":      { "sm": "1.75rem", "md": "2.35rem", "lg": "2.9rem" },
    "type-h1":      { "sm": "2.25rem", "md": "3.5rem", "lg": "4.5rem" },
    "type-display": { "sm": "3rem", "md": "4.5rem", "lg": "5.5rem" },
    "type-stat":    { "sm": "2.5rem", "md": "3.25rem", "lg": "3.75rem" },
    "type-placard": { "sm": "1.25rem", "md": "1.5rem", "lg": "1.75rem" },
    "leading-body":    { "sm": "1.6" },
    "leading-heading": { "sm": "1.12" },
    "leading-display": { "sm": "1.02" },
    "weight-regular":  { "sm": "400" },
    "weight-strong":   { "sm": "600" },
    "measure":         { "sm": "68ch" },

    "space-1":  { "sm": "0.25rem" }, "space-2": { "sm": "0.5rem" }, "space-3": { "sm": "0.75rem" },
    "space-4":  { "sm": "1rem" },    "space-5": { "sm": "1.5rem" }, "space-6": { "sm": "2rem" },
    "space-7":  { "sm": "3rem" },    "space-8": { "sm": "4rem" },   "space-9": { "sm": "6rem" },
    "space-section": { "sm": "3rem", "md": "4.5rem", "lg": "6rem" },
    "space-gutter":  { "sm": "1rem", "md": "1.5rem", "lg": "2rem" },
    "space-grid":    { "sm": "1rem", "md": "1.5rem", "lg": "1.75rem" },
    "width-content": { "sm": "720px" },
    "width-wide":    { "sm": "1200px" },

    "radius-control": { "sm": "10px" },
    "radius-card":    { "sm": "14px", "md": "16px" },
    "radius-media":   { "sm": "12px", "md": "16px" },
    "radius-hero":    { "sm": "18px", "md": "24px" },
    "radius-pill":    { "sm": "999px" },

    "elevation-1": { "sm": "0 1px 2px rgba(20,20,20,.06), 0 1px 1px rgba(20,20,20,.04)" },
    "elevation-2": { "sm": "0 6px 20px rgba(20,20,20,.10)" },
    "elevation-3": { "sm": "0 16px 40px rgba(20,20,20,.16)" },
    "elevation-offset": { "sm": "8px 8px 0 var(--aw-color-accent)", "md": "14px 14px 0 var(--aw-color-accent)" },

    "motion-fast": { "sm": "120ms" },
    "motion-base": { "sm": "200ms" },
    "motion-slow": { "sm": "320ms" },
    "motion-ease": { "sm": "cubic-bezier(.2,.7,.2,1)" },
    "motion-lift": { "sm": "-3px" },

    "z-sticky": { "sm": "50" },
    "z-header": { "sm": "40" },
    "z-overlay": { "sm": "100" },

    "size-target":  { "sm": "44px" },
    "size-control": { "sm": "48px" },
    "border-control": { "sm": "2px" },

    "card-columns":   { "sm": "1", "md": "2", "lg": "3" },
    "card-media-ratio": { "sm": "16/9" },
    "placard-ratio":  { "sm": "16/7", "md": "16/9" },
    "carousel-item":  { "sm": "82%", "md": "auto" }
  }
}
