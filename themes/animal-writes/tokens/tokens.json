{
  "$breakpoints": {
    "sm": 0,
    "md": 640,
    "lg": 1200
  },
  "$primitives": {
    "color": {
      "ink": "#141414",
      "ink-soft": "#1e1e1e",
      "paper": "#ffffff",
      "kraft": "#efe4cf",
      "kraft-soft": "#faf6ee",
      "muted": "#5f5f5f",
      "line": "#e4ddd0",
      "red": "#c8102e",
      "red-soft": "#fff2f4",
      "green": "#137a3b",
      "green-soft": "#eef8f1",
      "whatsapp": "#1f7a44",
      "canvas": "#f6f3ee",
      "wugweb-yellow": "#ffbe1a",
      "link-blue": "#0062b8"
    },
    "font": {
      "display": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "body": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    }
  },
  "tokens": {
    "color-bg": {
      "sm": "{color.canvas}"
    },
    "color-surface": {
      "sm": "{color.kraft}"
    },
    "color-surface-soft": {
      "sm": "{color.kraft-soft}"
    },
    "color-ink": {
      "sm": "{color.ink}"
    },
    "color-text": {
      "sm": "{color.ink-soft}"
    },
    "color-muted": {
      "sm": "{color.muted}"
    },
    "color-line": {
      "sm": "{color.line}"
    },
    "color-accent-ink": {
      "sm": "{color.link-blue}"
    },
    "color-on-accent": {
      "sm": "{color.ink}"
    },
    "color-danger": {
      "sm": "{color.red}"
    },
    "color-danger-soft": {
      "sm": "{color.red-soft}"
    },
    "color-success": {
      "sm": "{color.green}"
    },
    "color-success-soft": {
      "sm": "{color.green-soft}"
    },
    "color-focus": {
      "sm": "{color.link-blue}"
    },
    "color-whatsapp": {
      "sm": "{color.whatsapp}"
    },
    "font-display": {
      "sm": "{font.display}"
    },
    "font-body": {
      "sm": "{font.body}"
    },
    "radius-control": {
      "sm": "10px"
    },
    "radius-card": {
      "sm": "10px"
    },
    "color-canvas": {
      "sm": "{color.canvas}"
    },
    "color-link": {
      "sm": "{color.link-blue}"
    }
  }
}
