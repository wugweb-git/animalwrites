{
  "$breakpoints": {
    "sm": 0,
    "md": 768,
    "lg": 1200
  },
  "tokens": {
    "color-bg": {
      "sm": "var(--neutral-1)",
      "md": "var(--neutral-1)",
      "lg": "var(--neutral-1)"
    },
    "color-surface": {
      "sm": "#efe4cf",
      "md": "#efe4cf",
      "lg": "#efe4cf"
    },
    "color-surface-soft": {
      "sm": "var(--neutral-0)",
      "md": "var(--neutral-0)",
      "lg": "var(--neutral-0)"
    },
    "color-ink": {
      "sm": "#141414",
      "md": "#141414",
      "lg": "#141414"
    },
    "color-text": {
      "sm": "#1e1e1e",
      "md": "#1e1e1e",
      "lg": "#1e1e1e"
    },
    "color-muted": {
      "sm": "#5f5f5f",
      "md": "#5f5f5f",
      "lg": "#5f5f5f"
    },
    "color-line": {
      "sm": "#e4ddd0",
      "md": "#e4ddd0",
      "lg": "#e4ddd0"
    },
    "color-accent-ink": {
      "sm": "#0062b8",
      "md": "#0062b8",
      "lg": "#0062b8"
    },
    "color-on-accent": {
      "sm": "#141414",
      "md": "#141414",
      "lg": "#141414"
    },
    "color-danger": {
      "sm": "#c8102e",
      "md": "#c8102e",
      "lg": "#c8102e"
    },
    "color-danger-soft": {
      "sm": "#fff2f4",
      "md": "#fff2f4",
      "lg": "#fff2f4"
    },
    "color-success": {
      "sm": "#137a3b",
      "md": "#137a3b",
      "lg": "#137a3b"
    },
    "color-success-soft": {
      "sm": "#eef8f1",
      "md": "#eef8f1",
      "lg": "#eef8f1"
    },
    "color-focus": {
      "sm": "#0062b8",
      "md": "#0062b8",
      "lg": "#0062b8"
    },
    "color-whatsapp": {
      "sm": "#1f7a44",
      "md": "#1f7a44",
      "lg": "#1f7a44"
    },
    "font-display": {
      "sm": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "md": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "lg": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "font-body": {
      "sm": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "md": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "lg": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "radius-control": {
      "sm": "8px",
      "md": "8px",
      "lg": "8px"
    },
    "radius-card": {
      "sm": "12px",
      "md": "12px",
      "lg": "12px"
    },
    "color-canvas": {
      "sm": "var(--neutral-1)",
      "md": "var(--neutral-1)",
      "lg": "var(--neutral-1)"
    },
    "color-link": {
      "sm": "#0062b8",
      "md": "#0062b8",
      "lg": "#0062b8"
    },
    "surface-page": {
      "sm": "var(--kit-color-canvas)",
      "md": "var(--kit-color-canvas)",
      "lg": "var(--kit-color-canvas)"
    },
    "field-text-size": {
      "sm": "1rem",
      "md": ".875rem",
      "lg": ".875rem"
    },
    "type-sm": {
      "sm": "var(--fluid-body-sm)",
      "md": "clamp(.75rem, .7273rem + .0909vw, .8125rem)",
      "lg": "clamp(.75rem, .7273rem + .0909vw, .8125rem)"
    },
    "type-xs": {
      "sm": "var(--fluid-label)",
      "md": "clamp(.6875rem, .6591rem + .1136vw, .75rem)",
      "lg": "clamp(.6875rem, .6591rem + .1136vw, .75rem)"
    },
    "meta-size": {
      "sm": "12px",
      "md": ".8125rem",
      "lg": ".8125rem"
    },
    "btn-font-size": {
      "sm": ".875rem",
      "md": ".875rem",
      "lg": ".875rem"
    },
    "section-desc-size": {
      "sm": ".875rem",
      "md": ".875rem",
      "lg": ".875rem"
    },
    "card-min": {
      "sm": "18rem",
      "md": "18rem",
      "lg": "18rem"
    },
    "card-media-max": {
      "sm": "22.5rem",
      "md": "22.5rem",
      "lg": "22.5rem"
    },
    "thumb-min": {
      "sm": "4.5rem",
      "md": "4.5rem",
      "lg": "4.5rem"
    },
    "thumb-max": {
      "sm": "15rem",
      "md": "15rem",
      "lg": "15rem"
    },
    "body-min": {
      "sm": "10rem",
      "md": "10rem",
      "lg": "10rem"
    },
    "card-min-width": {
      "sm": "min(100%, var(--kit-card-min))",
      "md": "min(100%, var(--kit-card-min))",
      "lg": "min(100%, var(--kit-card-min))"
    },
    "card-stacked-gap": {
      "sm": "clamp(var(--kit-space-3), 5vw, var(--kit-space-5))",
      "md": "clamp(var(--kit-space-3), 5vw, var(--kit-space-5))",
      "lg": "clamp(var(--kit-space-3), 5vw, var(--kit-space-5))"
    },
    "card-stacked-media": {
      "sm": "clamp(var(--kit-thumb-min), 30%, var(--kit-thumb-max))",
      "md": "clamp(var(--kit-thumb-min), 30%, var(--kit-thumb-max))",
      "lg": "clamp(var(--kit-thumb-min), 30%, var(--kit-thumb-max))"
    },
    "card-stacked-media-max": {
      "sm": "none",
      "md": "none",
      "lg": "none"
    },
    "card-stacked-media-flex": {
      "sm": "0 1 auto",
      "md": "0 1 auto",
      "lg": "0 1 auto"
    },
    "card-stacked-media-min": {
      "sm": "var(--kit-thumb-min)",
      "md": "var(--kit-thumb-min)",
      "lg": "var(--kit-thumb-min)"
    },
    "card-stacked-body-flex": {
      "sm": "1 1 0",
      "md": "1 1 0",
      "lg": "1 1 0"
    },
    "card-stacked-body-min": {
      "sm": "var(--kit-body-min)",
      "md": "var(--kit-body-min)",
      "lg": "var(--kit-body-min)"
    },
    "card-block-media-max": {
      "sm": "var(--kit-card-media-max)",
      "md": "var(--kit-card-media-max)",
      "lg": "var(--kit-card-media-max)"
    },
    "lead-title-leading": {
      "sm": "1.25",
      "md": "1.25",
      "lg": "1.25"
    }
  }
}
