{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Animal Writes",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "name": "Accent", "color": "#ffa500" },
				{ "slug": "secondary", "name": "Ink", "color": "#141414" },
				{ "slug": "background", "name": "Background", "color": "#fffbf7" },
				{ "slug": "surface", "name": "Surface warm", "color": "#fff5eb" },
				{ "slug": "foreground", "name": "Foreground", "color": "#1e1e1e" },
				{ "slug": "text-muted", "name": "Text muted", "color": "#6e6e6e" },
				{ "slug": "border", "name": "Border", "color": "#e6e6e6" },
				{ "slug": "success", "name": "Success", "color": "#16a249" },
				{ "slug": "warning", "name": "Warning", "color": "#c88a04" },
				{ "slug": "error", "name": "Error", "color": "#dc2626" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--secondary)",
					"text": "var(--wp--preset--color--background)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"link": {
				":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
			}
		}
	}
}
