   ],
   "a11y": {
    "element": "<button> for actions, <a> for navigation",
    "aria": "aria-busy=\"true\" while sending; disabled buttons use the disabled attribute",
    "keyboard": "Tab; Enter (links); Enter or Space (buttons)",
    "focus": "--kit-focus-width ring in --kit-color-focus, --kit-focus-offset offset (:focus-visible)",
    "target": "44px minimum (small); 48px default",
    "motion": "colour fade, 1px press and a 3px icon nudge; none with prefers-reduced-motion",
    "sr": "visible label; icon-only <button> carries aria-label; icon-only core block keeps its text for screen readers",
    "contrast": [
     "kit-btn-primary-fg",
     "kit-btn-primary-bg"
    ],
    "contrast_pairs": [
     [
