{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#ffbe1a" },
				{ "slug": "secondary", "name": "Secondary", "color": "#191919" },
				{ "slug": "background", "name": "Background", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f4f4f4" },
				{ "slug": "foreground", "name": "Foreground", "color": "#1a1a1a" },
				{ "slug": "text-muted", "name": "Text muted", "color": "#7d7d7d" },
				{ "slug": "border", "name": "Border", "color": "#dfdfdf" },
				{ "slug": "success", "name": "Success", "color": "#16a249" },
				{ "slug": "warning", "name": "Warning", "color": "#c88a04" },
				{ "slug": "error", "name": "Error", "color": "#dc2828" },
				{ "slug": "neutral-0", "name": "Neutral 0 (Pure White)", "color": "#FFFFFF" },
				{ "slug": "neutral-1", "name": "Neutral 1 (Soft White)", "color": "#F4F4F4" },
				{ "slug": "neutral-2", "name": "Neutral 2 (Light Grey)", "color": "#DFDFDF" },
				{ "slug": "neutral-3", "name": "Neutral 3 (Muted Text)", "color": "#BABABA" },
				{ "slug": "neutral-4", "name": "Neutral 4 (Subtle Text)", "color": "#A3A3A3" },
				{ "slug": "neutral-5", "name": "Neutral 5 (Border Strong)", "color": "#7D7D7D" },
				{ "slug": "neutral-6", "name": "Neutral 6", "color": "#636363" },
				{ "slug": "neutral-7", "name": "Neutral 7", "color": "#4A4A4A" },
				{ "slug": "neutral-8", "name": "Neutral 8", "color": "#2E2E2E" },
				{ "slug": "neutral-9", "name": "Neutral 9", "color": "#141414" },
				{ "slug": "neutral-10", "name": "Neutral 10", "color": "#000000" },
				{ "slug": "peach", "name": "Peach (Error / Action)", "color": "#E54F30" },
				{ "slug": "green", "name": "Green (Success / Growth)", "color": "#3ED219" },
				{ "slug": "blue", "name": "Blue (Accent / Engineering)", "color": "#2368D7" },
				{ "slug": "aqua", "name": "Aqua (Experience / Vibrant)", "color": "#09E2C0" },
				{ "slug": "yellow", "name": "Primary Yellow (Brand Accent ≤10%)", "color": "#FFBE1A" },
				{ "slug": "grey", "name": "Grey (Subtle Text)", "color": "#C9C9C9" },
				{ "slug": "ash", "name": "Ash (Surface Elevated)", "color": "#191919" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "base",
					"name": "Inter Tight",
					"fontFamily": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "caption", "name": "Caption", "size": "clamp(0.625rem, 0.5682rem + 0.2424vw, 0.75rem)", "fluid": false },
				{ "slug": "label", "name": "Label", "size": "clamp(0.75rem, 0.6932rem + 0.2424vw, 0.875rem)", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "clamp(0.8125rem, 0.7841rem + 0.1212vw, 0.875rem)", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "clamp(0.9375rem, 0.9091rem + 0.1212vw, 1rem)", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "clamp(1rem, 0.9432rem + 0.2424vw, 1.125rem)", "fluid": false },
				{ "slug": "h5", "name": "Heading 5", "size": "1rem", "fluid": false },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(1.0625rem, 1.0341rem + 0.1212vw, 1.125rem)", "fluid": false },
				{ "slug": "2x-large", "name": "2X large", "size": "clamp(1.25rem, 1.1932rem + 0.2424vw, 1.375rem)", "fluid": false },
				{ "slug": "3x-large", "name": "3X large", "size": "clamp(1.5rem, 1.3864rem + 0.4848vw, 1.75rem)", "fluid": false },
				{ "slug": "4x-large", "name": "4X large", "size": "clamp(2rem, 1.5455rem + 1.9394vw, 3rem)", "fluid": false },
				{ "slug": "display", "name": "Display", "size": "clamp(2.5rem, 1.3636rem + 4.8485vw, 5rem)", "fluid": false }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "0", "name": "None", "size": "0px" },
				{ "slug": "10", "name": "XS", "size": "4px" },
				{ "slug": "20", "name": "S", "size": "8px" },
				{ "slug": "30", "name": "M", "size": "12px" },
				{ "slug": "40", "name": "L", "size": "16px" },
				{ "slug": "50", "name": "XL", "size": "24px" },
				{ "slug": "60", "name": "2XL", "size": "32px" },
				{ "slug": "70", "name": "3XL", "size": "40px" },
				{ "slug": "80", "name": "4XL", "size": "48px" }
			]
		},
		"custom": {
			"radius": { "none": "0px", "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "2xl": "24px", "full": "9999px" },
			"line-height": { "sm": "1.5", "md": "1.5", "lg": "1.55", "heading": "1.15" }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--base)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--md)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"left": "var(--kit-space-gutter)",
				"right": "var(--kit-space-gutter)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--4-x-large)", "fontWeight": "700" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--3-x-large)", "fontWeight": "600" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--2-x-large)", "fontWeight": "600" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "600" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--h-5)", "fontWeight": "600" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--foreground)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--secondary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--50)",
						"right": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" }
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--text-muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page — Wide", "postTypes": [ "page" ] }
	]
}
