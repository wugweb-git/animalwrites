<?xml version="1.0"?>
<ruleset name="PlanWeb">
	<description>WordPress-Extra for PlanWeb (kept here, out of the plugin folder: Plugin Check rejects application files in a plugin; run: phpcs --standard=tools/ci/phpcs-planweb.xml), with its own capabilities, prefix and text domain.</description>
	<file>../../plugins/planweb</file>
	<arg name="extensions" value="php"/>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="planweb"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="planweb"/></property>
		</properties>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_planweb_entries"/>
				<element value="planweb_approve"/>
			</property>
		</properties>
	</rule>
</ruleset>
